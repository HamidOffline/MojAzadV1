<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_theme_background"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:titleTextColor="?attr/colorOnSurface" />

        </com.google.android.material.appbar.AppBarLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/md_theme_background">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:indeterminate="true"
                        android:visibility="invisible"
                        app:indicatorColor="@color/md_theme_primary"
                        app:trackColor="@color/md_theme_primaryContainer"
                        app:trackThickness="3dp" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_group"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/colorSurface"
                        app:tabGravity="center"
                        app:tabIndicatorColor="@color/md_theme_primary"
                        app:tabIndicatorFullWidth="false"
                        app:tabIndicatorHeight="3dp"
                        app:tabMode="scrollable"
                        app:tabRippleColor="@color/md_theme_primaryContainer"
                        app:tabSelectedTextColor="@color/md_theme_primary"
                        app:tabTextAppearance="@style/TabLayoutTextStyle"
                        app:tabTextColor="?attr/colorOnSurfaceVariant" />

                    <!-- MojAzad - Compact Auto Failover -->
                    <LinearLayout
                        android:id="@+id/layout_auto_failover"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/colorSurface"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Auto Failover"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_auto_failover_info"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="7dp"
                                android:contentDescription="Auto Failover information"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="i"
                                android:textAllCaps="false"
                                android:textColor="@color/md_theme_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="@android:color/transparent"
                                app:cornerRadius="14dp"
                                app:rippleColor="@color/md_theme_primaryContainer"
                                app:strokeColor="@color/md_theme_primary"
                                app:strokeWidth="1dp" />

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_auto_failover"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:contentDescription="Auto Failover"
                            android:showText="false" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color_light" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/view_pager"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/md_theme_background"
                        android:scrollbars="vertical" />

                    <!-- MojAzad - Professional Connection Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layout_test"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="6dp"
                        android:clickable="true"
                        android:contentDescription="Connection dashboard"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/md_theme_background"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/divider_color_light"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="9dp"
                            android:paddingEnd="116dp"
                            android:paddingBottom="9dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_dashboard_server"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:lines="1"
                                    android:text="Disconnected"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_dashboard_ping"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:lines="1"
                                    android:text="-- ms"
                                    android:textColor="@color/colorPing"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/iv_dashboard_health"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="5dp"
                                    android:contentDescription="Server health"
                                    android:visibility="gone"
                                    app:srcCompat="@drawable/ic_health_excellent"
                                    app:tint="@color/colorPing" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_test_state"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:lines="1"
                                android:text="@string/connection_not_connected"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="10sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_dashboard_download"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:lines="1"
                                    android:text="↓ 0 B"
                                    android:textColor="#00A86B"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_dashboard_upload"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:lines="1"
                                    android:text="↑ 0 B"
                                    android:textColor="#F59E0B"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_dashboard_duration"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:lines="1"
                                    android:text="⏱ 00:00:00"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:contentDescription="@string/tasker_start_service"
                        android:focusable="true"
                        android:src="@drawable/ic_play_24dp"
                        app:backgroundTint="@color/color_fab_active"
                        app:borderWidth="0dp"
                        app:elevation="8dp"
                        app:maxImageSize="26dp"
                        app:tint="@color/colorWhite"
                        app:useCompatPadding="true" />

                </FrameLayout>

            </androidx.coordinatorlayout.widget.CoordinatorLayout>

        </RelativeLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="?attr/colorOnSurfaceVariant"
        app:itemTextColor="?attr/colorOnSurface"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
